{
  "appId": "com.zhixing.reader",
  "productName": "知行读书",
  "directories": {
    "output": "installer-v2"
  },
  "asar": true,
  "asarUnpack": [
    "dist/**",
    "node_modules/sql.js/dist/sql-wasm.wasm"
  ],
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/sql.js/**",
    "node_modules/ts-fsrs/**",
    "node_modules/vectra/**",
    "node_modules/uuid/**",
    "node_modules/wink-bm25-text-search/**",
    "node_modules/wink-nlp/**",
    "node_modules/wink-eng-lite-web-model/**",
    "node_modules/gpt-tokenizer/**",
    "node_modules/cheerio/**",
    "node_modules/cheerio-select/**",
    "node_modules/dom-serializer/**",
    "node_modules/domhandler/**",
    "node_modules/domutils/**",
    "node_modules/domelementtype/**",
    "node_modules/entities/**",
    "node_modules/encoding-sniffer/**",
    "node_modules/htmlparser2/**",
    "node_modules/parse5/**",
    "node_modules/parse5-htmlparser2-tree-adapter/**",
    "node_modules/parse5-parser-stream/**",
    "node_modules/whatwg-mimetype/**",
    "node_modules/turndown/**",
    "node_modules/@mixmark-io/**",
    "node_modules/boolbase/**",
    "node_modules/css-select/**",
    "node_modules/css-what/**",
    "node_modules/nth-check/**",
    "node_modules/@grpc/**",
    "node_modules/@js-sdsl/**",
    "node_modules/ansi-regex/**",
    "node_modules/ansi-styles/**",
    "node_modules/base64-js/**",
    "node_modules/buffer/**",
    "node_modules/cliui/**",
    "node_modules/color-convert/**",
    "node_modules/color-name/**",
    "node_modules/colorette/**",
    "node_modules/dotenv/**",
    "node_modules/emoji-regex/**",
    "node_modules/escalade/**",
    "node_modules/get-caller-file/**",
    "node_modules/iconv-lite/**",
    "node_modules/ieee754/**",
    "node_modules/is-fullwidth-code-point/**",
    "node_modules/json-colorizer/**",
    "node_modules/lodash.camelcase/**",
    "node_modules/long/**",
    "node_modules/openai/**",
    "node_modules/protobufjs/**",
    "node_modules/require-directory/**",
    "node_modules/safer-buffer/**",
    "node_modules/string-width/**",
    "node_modules/strip-ansi/**",
    "node_modules/whatwg-encoding/**",
    "node_modules/wink-distance/**",
    "node_modules/wink-helpers/**",
    "node_modules/wink-jaro-distance/**",
    "node_modules/wink-nlp-utils/**",
    "node_modules/wink-porter2-stemmer/**",
    "node_modules/wink-tokenizer/**",
    "node_modules/wrap-ansi/**",
    "node_modules/y18n/**",
    "node_modules/yargs/**",
    "node_modules/yargs-parser/**",
    "node_modules/axios/**",
    "node_modules/follow-redirects/**",
    "node_modules/form-data/**",
    "node_modules/proxy-from-env/**"
  ],
  "extraResources": [
    {
      "from": "resources/dictionary.json",
      "to": "dictionary.json"
    },
    {
      "from": "resources/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "知行读书"
  },
  "artifactName": "知行读书 Setup ${version}.${ext}"
}
