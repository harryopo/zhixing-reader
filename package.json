{
  "name": "zhixing-reader",
  "version": "1.0.0",
  "description": "知行读书 - AI阅读成长助手",
  "main": "dist/main/main.js",
  "author": "张子涵",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "lint": "eslint src electron",
    "lint:fix": "eslint src electron --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build-dict": "node scripts/extract-dictionary.js",
    "seed:demo": "npx tsx scripts/seed-demo-data.ts",
    "seed:demo:watch": "npx tsx watch scripts/seed-demo-data.ts",
    "loop:log": "node scripts/loop-log.mjs",
    "loop:detect": "node scripts/loop-detect.mjs",
    "loop:detect:gates": "node scripts/loop-detect.mjs --gates"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@tailwindcss/postcss": "^4.3.0",
    "ai": "^7.0.35",
    "axios": "^1.7.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "react-shiki": "^0.11.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "ts-fsrs": "^5.4.1",
    "vectra": "^0.15.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.zhixing.reader",
    "productName": "知行读书",
    "directories": {
      "output": "installer"
    },
    "publish": null,
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/sql.js/**",
      "node_modules/ts-fsrs/**",
      "node_modules/axios/**",
      "node_modules/follow-redirects/**",
      "node_modules/form-data/**",
      "node_modules/proxy-from-env/**",
      "node_modules/vectra/**",
      "node_modules/uuid/**",
      "node_modules/wink-bm25-text-search/**",
      "node_modules/wink-nlp/**",
      "node_modules/wink-eng-lite-web-model/**",
      "node_modules/gpt-tokenizer/**",
      "node_modules/cheerio/**",
      "node_modules/cheerio-select/**",
      "node_modules/dom-serializer/**",
      "node_modules/domhandler/**",
      "node_modules/domutils/**",
      "node_modules/domelementtype/**",
      "node_modules/entities/**",
      "node_modules/encoding-sniffer/**",
      "node_modules/htmlparser2/**",
      "node_modules/parse5/**",
      "node_modules/parse5-htmlparser2-tree-adapter/**",
      "node_modules/parse5-parser-stream/**",
      "node_modules/whatwg-mimetype/**",
      "node_modules/turndown/**",
      "node_modules/@mixmark-io/**",
      "node_modules/boolbase/**",
      "node_modules/css-select/**",
      "node_modules/css-what/**",
      "node_modules/nth-check/**",
      "node_modules/@grpc/**",
      "node_modules/@js-sdsl/**",
      "node_modules/ansi-regex/**",
      "node_modules/ansi-styles/**",
      "node_modules/base64-js/**",
      "node_modules/buffer/**",
      "node_modules/cliui/**",
      "node_modules/color-convert/**",
      "node_modules/color-name/**",
      "node_modules/colorette/**",
      "node_modules/dotenv/**",
      "node_modules/emoji-regex/**",
      "node_modules/escalade/**",
      "node_modules/get-caller-file/**",
      "node_modules/iconv-lite/**",
      "node_modules/ieee754/**",
      "node_modules/is-fullwidth-code-point/**",
      "node_modules/json-colorizer/**",
      "node_modules/lodash.camelcase/**",
      "node_modules/long/**",
      "node_modules/openai/**",
      "node_modules/protobufjs/**",
      "node_modules/require-directory/**",
      "node_modules/safer-buffer/**",
      "node_modules/string-width/**",
      "node_modules/strip-ansi/**",
      "node_modules/whatwg-encoding/**",
      "node_modules/wink-distance/**",
      "node_modules/wink-helpers/**",
      "node_modules/wink-jaro-distance/**",
      "node_modules/wink-nlp-utils/**",
      "node_modules/wink-porter2-stemmer/**",
      "node_modules/wink-tokenizer/**",
      "node_modules/wrap-ansi/**",
      "node_modules/y18n/**",
      "node_modules/yargs/**",
      "node_modules/yargs-parser/**"
    ],
    "extraResources": [
      {
        "from": "resources/dictionary.json",
        "to": "dictionary.json"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知行读书"
    }
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
