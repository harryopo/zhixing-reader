{
  "name": "zhixing-reader",
  "version": "1.0.0",
  "description": "知行读书 - AI阅读成长助手",
  "main": "dist/main/main.js",
  "author": "张子涵",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "lint": "eslint src electron",
    "lint:fix": "eslint src electron --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build-dict": "node scripts/extract-dictionary.js",
    "seed:demo": "npx tsx scripts/seed-demo-data.ts",
    "seed:demo:watch": "npx tsx watch scripts/seed-demo-data.ts",
    "loop:log": "node scripts/loop-log.mjs",
    "loop:detect": "node scripts/loop-detect.mjs",
    "loop:detect:gates": "node scripts/loop-detect.mjs --gates"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "@tailwindcss/postcss": "^4.3.0",
    "axios": "^1.7.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "react-shiki": "^0.11.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "ts-fsrs": "^5.4.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.zhixing.reader",
    "productName": "知行读书",
    "directories": {
      "output": "installer"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/sql.js/**",
      "node_modules/ts-fsrs/**",
      "node_modules/@qdrant/**",
      "node_modules/axios/**",
      "node_modules/follow-redirects/**",
      "node_modules/form-data/**",
      "node_modules/proxy-from-env/**"
    ],
    "extraResources": [
      {
        "from": "resources/dictionary.json",
        "to": "dictionary.json"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知行读书"
    }
  }
}
