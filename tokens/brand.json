{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "comment": "调色板唯一真值。改色只改这里，然后 npm run build:tokens。CSS 与 TS 两份产物由脚本生成，不要手改。",
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "#0c3b2e", "$description": "徽标环与应用图标底板" },
