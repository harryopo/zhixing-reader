    },
    "blue": { "500": { "$type": "color", "$value": "#3b82f6" } },
    "violet": { "400": { "$type": "color", "$value": "#a78bfa" } },
    "amber": { "500": { "$type": "color", "$value": "#f59e0b" } },
    "rose": { "500": { "$type": "color", "$value": "#f43f5e" } },
    "lime": { "500": { "$type": "color", "$value": "#84cc16" } },
    "green": { "500": { "$type": "color", "$value": "#22c55e" } },
