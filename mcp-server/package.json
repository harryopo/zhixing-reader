{
  "name": "zhixing-reader-mcp-server",
  "version": "1.0.0",
  "description": "知行读书 MCP Server - 让 Claude Desktop / Cursor 等 LLM 客户端查询知行读书的本地数据库（只读）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zhixing-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zhixing-reader",
    "reading",
    "fsrs",
    "spaced-repetition"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "sql.js": "^1.14.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^2.0.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  }
}
